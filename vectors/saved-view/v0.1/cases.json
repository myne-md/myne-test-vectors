      "input_bytes_utf8_hex": "5b7b22636172645f73697a65223a3165332c2266696c74657273223a7b226b696e64223a22616c6c227d2c226964223a2278222c226e616d65223a226e222c22766965775f74797065223a227461626c65227d5d",
      "expected_error": "malformed"
