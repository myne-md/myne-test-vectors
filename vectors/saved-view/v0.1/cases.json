{
  "schema": "saved-view",
  "protocol_version": "v0.1",
  "spec_section": "protocol.md §9.5.2 (saved_views canonical JSON inside vault.prefs)",
  "description": "Pins protocol::saved_view::parse_saved_views_array — the canonical-JSON decoder for the saved_views array embedded in vault.prefs (MYND-271, Saved Views). parse_ok cases pin the decoded view-set as its canonical re-encoding (NFC folding + lexicographic key order + id-sort) plus the exact consumed byte count (the cursor-advance contract the prefs decoder relies on); parse_fail cases pin the closed error surface (malformed / missing_field / wrong_type / unrepresentable — the last covers map view-type, unknown filter kind, unknown operator). Cases generated by `cargo test -p protocol --lib emit_saved_view_vectors_for_paste -- --ignored`.",
  "cases": [
    {
      "vector_id": "saved-view/v0.1/roundtrip-rich",
      "description": "A fully-populated view (every optional field set) round-trips: canonical input re-encodes to itself and consumed equals the whole array.",
      "case_kind": "parse_ok",
      "input_bytes_utf8_hex": "",
      "expected_consumed_len": 333,
      "expected_canonical_utf8_hex": ""
    },
    {
      "vector_id": "saved-view/v0.1/multi-sorted-by-id",
      "description": "Two views: the array is emitted sorted by id (v0 before v1) regardless of caller order.",
      "case_kind": "parse_ok",
      "input_bytes_utf8_hex": "",
      "expected_consumed_len": 404,
      "expected_canonical_utf8_hex": ""
    },
    {
      "vector_id": "saved-view/v0.1/empty-array",
      "description": "The empty array decodes to zero views and consumes exactly two bytes.",
      "case_kind": "parse_ok",
      "input_bytes_utf8_hex": "5b5d",
      "expected_consumed_len": 2,
      "expected_canonical_utf8_hex": "5b5d"
    },
    {
      "vector_id": "saved-view/v0.1/normalize-whitespace-and-key-order",
      "description": "Pretty-printed, reordered input decodes and re-encodes to canonical bytes (whitespace stripped, keys lexicographically sorted) — the input and the canonical projection differ.",
      "case_kind": "parse_ok",
      "input_bytes_utf8_hex": "5b207b0a202022766965775f7479706522203a20227461626c6522202c0a2020226e616d6522203a20226e22202c0a202022696422203a20227822202c0a20202266696c7465727322203a207b20226b696e6422203a2022616c6c22207d0a7d205d",
      "expected_consumed_len": 98,
      "expected_canonical_utf8_hex": "5b7b2266696c74657273223a7b226b696e64223a22616c6c227d2c226964223a2278222c226e616d65223a226e222c22766965775f74797065223a227461626c65227d5d"
    },
    {
      "vector_id": "saved-view/v0.1/nfc-fold-name",
      "description": "A name carrying an NFD combining sequence (e + COMBINING ACUTE) folds to NFC in the canonical projection.",
      "case_kind": "parse_ok",
      "input_bytes_utf8_hex": "5b7b2266696c74657273223a7b226b696e64223a22616c6c227d2c226964223a2278222c226e616d65223a2265cc81222c22766965775f74797065223a227461626c65227d5d",
      "expected_consumed_len": 70,
      "expected_canonical_utf8_hex": "5b7b2266696c74657273223a7b226b696e64223a22616c6c227d2c226964223a2278222c226e616d65223a22c3a9222c22766965775f74797065223a227461626c65227d5d"
    },
    {
      "vector_id": "saved-view/v0.1/consumes-only-the-array-trailing",
      "description": "Trailing bytes after the array are left for the caller: consumed reports only the array length, not the full input.",
      "case_kind": "parse_ok",
      "input_bytes_utf8_hex": "",
      "expected_consumed_len": 333,
      "expected_canonical_utf8_hex": ""
    },
    {
      "vector_id": "saved-view/v0.1/unknown-field-tolerated",
      "description": "An unknown future key on a view object is ignored (forward-compat) and dropped from the canonical projection.",
      "case_kind": "parse_ok",
      "input_bytes_utf8_hex": "5b7b2266696c74657273223a7b226b696e64223a22616c6c227d2c22667574757265223a34322c226964223a2278222c226e616d65223a226e222c22766965775f74797065223a227461626c65227d5d",
      "expected_consumed_len": 80,
