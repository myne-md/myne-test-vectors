      "input_markdown_utf8_hex": "6265666f726520252561206e6f746525252061667465720a",
      "informational_markdown": "before %%a note%% after\n",
      "expected_has_comment": true,
      "expected_stripped_utf8_hex": "6265666f7265202061667465720a",
      "informational_stripped": "before  after\n"
    },
