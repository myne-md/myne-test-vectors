{
  "schema": "task-query-grammar",
  "protocol_version": "v0.1",
  "spec_section": "markdown-dialect.md §3.9 (task-query block roster)",
  "description": "Pins the closed task-query grammar (src/notes/taskQuery.ts) — BOTH what it accepts and what it refuses. A parse-only vector set would still pass for a port that accepted one extra clause, so the drop cases carry the closedness claim: all three function-valued forms, a field name in a value position (the boundary rule — a field name may never appear where a value goes), arithmetic over a field, and out-of-roster words. The `refuse` cases pin the widen guard: an all-dropped query must NOT collapse to matching everything, while a genuinely empty query is legitimately unfiltered. TS-runner category (no Rust generator).",
  "cases": [
    {
      "vector_id": "task-query-grammar/v0.1/done",
      "description": "Completion state: done.",
      "case_kind": "parse",
      "query": "done",
      "expected_clause_kinds": [
        "done"
      ],
      "expected_dropped": [],
      "expected_refused": false
    },
    {
      "vector_id": "task-query-grammar/v0.1/not-done",
      "description": "Completion state: not done.",
      "case_kind": "parse",
      "query": "not done",
      "expected_clause_kinds": [
        "done"
      ],
      "expected_dropped": [],
      "expected_refused": false
    },
    {
