  "spec_section": "markdown-dialect.md §3.8.7 (recurrence rule vocabulary)",
  "description": "Pins the recurrence vocabulary and its civil-date arithmetic (dialect/src/recurrence.ts + civilDate.ts) so every client computes identical next dates. Covers both anchoring modes, both rule families, month-end clamping, the leap day, the stale-date catch-up, the reminder co-advance, and unrecognized rules. All arithmetic is over civil year/month/day fields anchored to UTC and is therefore DST-independent — a port that forms a local instant will disagree on the transition cases. TS-runner category (no Rust generator).",
  "cases": [
    {
      "vector_id": "task-recurrence/v0.1/interval-daily",
      "description": "A daily rule advances one day.",
      "rule": "every day",
      "today": "2026-07-28",
      "due": "2026-07-28",
      "case_kind": "advance",
      "expected_rule_recognized": true,
      "expected_canonical_rule": "every day",
      "expected_mode": "due",
      "expected_family": "interval",
      "expected_due": "2026-07-29"
    },
