      "input_yaml_utf8_hex": "70726f703a2068656c6c6f20776f726c64",
      "informational_yaml": "prop: hello world",
      "expected_type": "string",
      "expected_normalized_utf8_hex": "68656c6c6f20776f726c64",
      "informational_normalized": "hello world"
    },
