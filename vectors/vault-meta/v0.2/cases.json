{
  "schema": "vault-meta",
  "protocol_version": "v0.2",
  "spec_section": "protocol.md §9.3 + §10.4.1 + §10.5",
  "description": "Pins serialize_vault_meta_v0_2 + parse_vault_meta_v0_2 (NTV5). Identical 345-byte layout to MYV1 with bytes [0..5] swapped to magic NTV5 + protocol_version 0x02 — the 0x02 side of the frozen §10.4.1 md.6 split. The two reject cases are the load-bearing ones: §10.5 anti-downgrade means a MYV1 blob must not parse as v0.2 and an NTV5 blob must not parse as v0.1, which a round-trip alone would not catch in an implementation that ignored the magic. Generated by `cargo test -p protocol --lib emit_vault_meta_v0_2_vectors_for_paste -- --ignored --nocapture`.",
  "cases": [
    {
      "vector_id": "vault-meta/v0.2/canonical-roundtrip",
      "description": "Hand-crafted fixture, byte patterns 0x5A..0x63 (distinct from the v0.1 category's 0xDA..0xE3 so a cross-category diff cannot show one set for the other). FAST_TEST_KDF params.",
      "case_kind": "roundtrip",
      "input_account_number_hash_hex": "5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a",
      "input_kdf_params": {
        "m_kib": 8,
        "t": 1,
        "p": 1,
        "argon2_version_hex": "13"
      },
      "input_random_salt_password_hex": "5b5b5b5b5b5b5b5b5b5b5b5b5b5b5b5b",
      "input_random_salt_recovery_hex": "5c5c5c5c5c5c5c5c5c5c5c5c5c5c5c5c",
      "input_nonce_password_wrap_hex": "5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d",
      "input_enc_root_key_password_hex": "5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e",
      "input_nonce_recovery_wrap_hex": "5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f",
      "input_enc_root_key_recovery_hex": "60606060606060606060606060606060606060606060606060606060606060606060606060606060606060606060606060606060606060606060606060606060",
      "input_items_key_id_hex": "61616161616161616161616161616161",
      "input_items_key_nonce_hex": "626262626262626262626262626262626262626262626262",
      "input_enc_items_key_hex": "63636363636363636363636363636363636363636363636363636363636363636363636363636363636363636363636363636363636363636363636363636363",
      "expected_blob_hex": ""
    },
    {
      "vector_id": "vault-meta/v0.2/rejects-v0-1-magic",
      "description": "§10.5 anti-downgrade: the SAME fields serialized as MYV1 must be rejected by the v0.2 parser. Bytes [5..] are byte-identical to the roundtrip case, so only the magic + version separate them.",
      "case_kind": "parse_fail",
      "input_blob_hex": "",
      "expected_error": "invalid_vault_meta"
    },
    {
      "vector_id": "vault-meta/v0.2/v0-1-parser-rejects-ntv5",
      "description": "The other direction: a v0.1 client must refuse an NTV5 blob rather than half-parse it (§10.5, the fleet safety gate for a cut-over vault reached by an un-upgraded client).",
      "case_kind": "parse_fail_v0_1",
      "input_blob_hex": "",
      "expected_error": "invalid_vault_meta"
    },
    {
      "vector_id": "vault-meta/v0.2/membership-absent",
      "description": "An NTV5 vault.meta with no membership field: 345 bytes, reserved byte 0x00. parse_vault_meta_v0_2 must accept it and report membership: None (unmigrated). Generated by `cargo test -p protocol --lib emit_membership_vectors_for_paste -- --ignored --nocapture`.",
      "case_kind": "membership_absent",
      "input_blob_hex": "",
      "expected_membership": "absent"
