    {
      "vector_id": "vault-meta/v0.2/membership-present",
      "description": "An NTV5 vault.meta with the membership field present: 417 bytes, reserved byte 0x01, a 16-byte account id sealed under membership_key (root_key = 0x11.., account_number_hash = 0x44.., nonce = 0xCD..). parse_vault_meta_v0_2 must accept it and unseal_membership must recover the account id.",
      "case_kind": "membership_present",
      "input_blob_hex": "",
      "input_root_key_hex": "1111111111111111111111111111111111111111111111111111111111111111",
      "input_account_number_hash_hex": "44444444444444444444444444444444",
