{
  "schema": "backup-container",
  "protocol_version": "v0.1",
  "spec_section": "protocol.md §9.11",
  "description": "Pins the MYB1 .myne-backup container codec (MYND-254; codec landed MYND-217, spec §9.11): write_container + read_and_verify_container + the §9.11.3 closed-allowlist classifier in src-tauri/src/backup_container.rs (package myne-desktop — the first family whose reference implementation lives OUTSIDE the protocol crate; the codec is std/fs-bound by design). The container is a credential-free, UNKEYED integrity layer: per-member SHA-256 over path_len_be16 || path || member_bytes detects accidental corruption, never tampering (tamper defense = per-blob AEAD). Member content is opaque at this layer; vault.meta presence + exact-345 structural parse is the restore engine's stage 5 and is deliberately NOT vectored here. 32 cases: 2 encode (minimal vault.meta-only + full-allowlist; input member order is deliberately UNSORTED — the writer must sort by raw path bytes, so same member set always yields identical container bytes) + 2 verify_ok (records with independently checkable sha256_hex) + 14 verify_fail (all 13 vectorable BackupContainerError variants + the MYB5 v005-reservation magic case; the two ceiling cases are 22-byte header-only files pinning the §9.11.6 stage order: ceilings BEFORE the file-length equation) + 14 classify_path (one accept per family + 8 load-bearing rejects). Cases generated by `cargo test -p myne-desktop --lib emit_backup_container_vectors_for_paste -- --ignored` (in src-tauri/src/backup_container.rs).",
  "cases": [
    {
      "vector_id": "backup-container/v0.1/encode-minimal-vault-meta-only",
      "description": "The smallest valid container: the single REQUIRED member vault.meta (345 bytes, §9.3 fixed length; content is an opaque 0xAB fill — the container never parses member bytes). Layout: 22-byte header + one 52-byte record (42 fixed + 10-byte path) + 345 data bytes = 419 total.",
      "case_kind": "encode",
      "input_members": [
        { "path": "vault.meta", "bytes_hex": "" }
      ],
      "expected_container_hex": ""
    },
    {
      "vector_id": "backup-container/v0.1/encode-full-allowlist-canonical-order",
      "description": "One member per §9.11.3 family, presented in DELIBERATELY unsorted input order. The writer MUST sort records by raw path bytes (attachments/* < notes/* < snapshots/* < vault.attachments < vault.meta < vault.prefs) and lay data in table order — so the same member set always encodes to identical bytes regardless of input order (§9.11.2 canonical-encoding pin).",
      "case_kind": "encode",
      "input_members": [
        { "path": "vault.meta", "bytes_hex": "" },
        { "path": "snapshots/0190a000-0000-7000-8000-00000000000a__0190a000-0000-7000-8000-00000000000b.myn", "bytes_hex": "736e617073686f742d636970686572746578742d7374616e642d696e" },
        { "path": "attachments/abababababababababababababababababababababababababababababababab", "bytes_hex": "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee" },
        { "path": "vault.prefs", "bytes_hex": "70726566732d636970686572746578742d7374616e642d696e" },
        { "path": "notes/0190a000-0000-7000-8000-00000000000a.myn", "bytes_hex": "6e6f74652d636970686572746578742d7374616e642d696e" },
        { "path": "vault.attachments", "bytes_hex": "636174616c6f672d636970686572746578742d7374616e642d696e" }
      ],
      "expected_container_hex": ""
    },
    {
      "vector_id": "backup-container/v0.1/verify-ok-minimal",
      "description": "Parse + verify the minimal container back to its single record. The sha256_hex value is independently checkable: SHA-256(path_len_be16 || path || member_bytes) per §9.11.2 — the hash formula pin.",
      "case_kind": "verify_ok",
      "input_container_hex": "",
      "expected_member_records": [
        { "path": "vault.meta", "len": 345, "sha256_hex": "e53140858f383a173f0e6d6b789d5d18d925879360c71700e642b6fd3583d26c" }
      ]
    },
    {
      "vector_id": "backup-container/v0.1/verify-ok-full-allowlist",
