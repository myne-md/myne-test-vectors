        { "path": "snapshots/0190a000-0000-7000-8000-00000000000a__0190a000-0000-7000-8000-00000000000b.myn", "len": 28, "sha256_hex": "21e5e7644b3fd7be67b369e5878160b88a9d678738cd8b8c7c26f8500e01dbc3" },
