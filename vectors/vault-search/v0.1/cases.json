      "input_blob_hex": "4d595331010199999999999999999999999999999999999999999999999900000044f2aa6a1e54b642df5ec2617bf427d6fbbf749c68190c9a6267d4aef5959b52f362b0d1b3f6b4a6048724b92d5579e9837a66ff2534f1943f5617fd228e5ab68d6d24ddb0",
      "input_root_key_hex": "4242424242424242424242424242424242424242424242424242424242424242",
      "input_account_number_hash_hex": "7d7d7d7d7d7d7d7d7d7d7d7d7d7d7d7d",
      "expected_kind": "aead_fail",
      "informational_tamper_description": "intact blob decrypted under wrong account_number_hash (0x7d×16)"
