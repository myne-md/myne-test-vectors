      "expected_search_blob_hex": ""
    },
    {
      "vector_id": "vault-search/v0.1/decrypt-ok-1kb",
      "description": "Round-trip the 1-KB blob back to its opaque plaintext under the matching root_key (→ search_index_key) + account_number_hash. Proves the decoder's header parse + AEAD unwrap reconstruct the exact inner bytes the desktop layer will deserialize.",
      "case_kind": "decrypt_ok",
      "input_blob_hex": "",
      "input_root_key_hex": "4242424242424242424242424242424242424242424242424242424242424242",
