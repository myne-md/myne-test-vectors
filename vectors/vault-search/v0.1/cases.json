      "expected_search_blob_hex": "4d595331010199999999999999999999999999999999999999999999999900000044f2aa6a1e54b642df5ec2617bf427d6fbbf749c68190c9a6267d4aef5959b52f362b0d1b3f6b4a6048724b92d5579e9837a66ff2534f1943f5617fd228e5ab68d6d24ddb0"
    },
    {
      "vector_id": "vault-search/v0.1/encrypt-1kb",
      "description": "Encode a 1024-byte plaintext where byte i = (i mod 256). Mid-size case — exercises a full XChaCha20 keystream block plus tail. Expected blob = 34 + 1024 + 32 = 1090 bytes.",
      "case_kind": "encrypt",
      "input_root_key_hex": "4242424242424242424242424242424242424242424242424242424242424242",
      "input_account_number_hash_hex": "7c7c7c7c7c7c7c7c7c7c7c7c7c7c7c7c",
      "input_plaintext_hex": "",
