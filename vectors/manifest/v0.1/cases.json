{
  "schema": "manifest",
  "protocol_version": "v0.1",
  "spec_section": "sync-protocol.md §4.2 (MYND-414)",
  "description": "Pins the canonical vault-head manifest byte encoding (uuid->content_nonce, sorted ascending by id) and its SHA-256 manifest_hash, for Rust<->Go bit-identical validation. Generated by `cargo test -p protocol --lib emit_manifest_vectors_for_paste -- --ignored`.",
  "cases": [
    {
      "vector_id": "manifest/v0.1/encode-empty",
      "description": "Empty manifest (a vault with no content blobs): header only, entry_count=0. The genesis head over an empty vault commits SHA-256 of this.",
      "case_kind": "encode",
      "input_entries": [],
      "expected_manifest_bytes_hex": "6d796e652e76302e317c7661756c742d6d616e69666573747c010100000000",
      "expected_manifest_hash_hex": "bd713dd67464b0e09694ea1c76d7f985bfe55a52e74d847e14652d7a782c5f22"
    },
    {
      "vector_id": "manifest/v0.1/encode-single-note",
      "description": "One note: id 0x01.. with content_nonce 0xaa.. .",
      "case_kind": "encode",
      "input_entries": [{ "input_id_hex": "01010101010101010101010101010101", "input_content_nonce_hex": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" }],
      "expected_manifest_bytes_hex": "6d796e652e76302e317c7661756c742d6d616e69666573747c01010000000101010101010101010101010101010101aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "expected_manifest_hash_hex": "332aaa9a175f5979c17cfd279f12916e0db8e20d2ab4d9c1186d6880d3314049"
    },
    {
      "vector_id": "manifest/v0.1/encode-multi-unsorted",
      "description": "Three content blobs supplied UNSORTED (ids 0x09, 0x01, 0x05) to pin the canonical ascending-by-id sort; a port that skips the sort emits different bytes and a different manifest_hash.",
      "case_kind": "encode",
      "input_entries": [{ "input_id_hex": "09090909090909090909090909090909", "input_content_nonce_hex": "999999999999999999999999999999999999999999999999" }, { "input_id_hex": "01010101010101010101010101010101", "input_content_nonce_hex": "111111111111111111111111111111111111111111111111" }, { "input_id_hex": "05050505050505050505050505050505", "input_content_nonce_hex": "555555555555555555555555555555555555555555555555" }],
      "expected_manifest_bytes_hex": "",
      "expected_manifest_hash_hex": "4ea0e21b8f9bc34e88528aeff8ad3e401f264bed607df1a4166b7767ec54438b"
    },
    {
      "vector_id": "manifest/v0.1/encode-with-tombstone",
      "description": "A live note (0x01) plus a `deleted`-marked tombstone version (0x02, fresh content_nonce 0xde..). Per §4.2 a tombstone stays in the manifest until horizon-GC, so it is just another entry the head commits.",
      "case_kind": "encode",
      "input_entries": [{ "input_id_hex": "01010101010101010101010101010101", "input_content_nonce_hex": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" }, { "input_id_hex": "02020202020202020202020202020202", "input_content_nonce_hex": "dededededededededededededededededededededededede" }],
      "expected_manifest_bytes_hex": "6d796e652e76302e317c7661756c742d6d616e69666573747c01010000000201010101010101010101010101010101aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa02020202020202020202020202020202dededededededededededededededededededededededede",
      "expected_manifest_hash_hex": "02973fee532272b0b5d590e459045bb7f003088113f483e6751050720578ead0"
    },
    {
      "vector_id": "manifest/v0.1/parse-fail-domain-prefix",
      "description": "First byte of the domain prefix corrupted; rejected before any field read (hash-domain separation, §3.5).",
      "case_kind": "parse_fail",
      "input_manifest_bytes_hex": "58796e652e76302e317c7661756c742d6d616e69666573747c01010000000101010101010101010101010101010101aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "expected_error": "domain_prefix_mismatch"
    },
    {
      "vector_id": "manifest/v0.1/parse-fail-format-unsupported",
      "description": "manifest_format_version set to 0x02 — a future manifest serialization a v0.1 client does not understand; rejected cleanly (forward hook).",
      "case_kind": "parse_fail",
      "input_manifest_bytes_hex": "6d796e652e76302e317c7661756c742d6d616e69666573747c01020000000101010101010101010101010101010101aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "expected_error": "format_unsupported"
    },
    {
      "vector_id": "manifest/v0.1/parse-fail-trailing-bytes",
      "description": "One extra trailing byte after a complete manifest; strict decode rejects.",
      "case_kind": "parse_fail",
      "input_manifest_bytes_hex": "6d796e652e76302e317c7661756c742d6d616e69666573747c01010000000101010101010101010101010101010101aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa00",
      "expected_error": "trailing_bytes"
    }
  ]
}
