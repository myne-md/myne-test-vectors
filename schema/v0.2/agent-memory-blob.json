{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myne-md.github.io/myne-test-vectors/schema/v0.2/agent-memory-blob.json",
  "title": "agent-memory-blob — case shape (v0.2)",
  "description": "Pins the migrated memory-entry envelope (MYX5, §10.4.1, myne-md/myne#697): the v0.2 seal (v0.2 KEK via derive_subkey_versioned + v0.2 per-entry AAD binding the entry id) over the entry bytes, and the v0.1 expectation refusing MYX5. Unlike the singletons, the per-entry families carry the generation in the header version byte (0x02), which the runner pins rather than assuming. Two case kinds: 'encrypt' (decode-verified fixture + magic/version pins) and 'decode_fail_v0_1' (the v0.1 expectation refuses MYX5 at the magic check, before any decryption). The Rust reference implementation lives at protocol/src/agent_memory_entry_blob.rs (main myne repository).",
  "type": "object",
  "required": ["vector_id", "description", "case_kind"],
  "unevaluatedProperties": false,
  "properties": {
    "vector_id": {
      "type": "string",
      "pattern": "^agent-memory-blob/v0\\.2/[a-z0-9-]+$",
      "description": "Stable identifier of the form 'agent-memory-blob/v0.2/<descriptive-slug>'. Immutable once shipped."
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "case_kind": {
      "type": "string",
      "enum": ["encrypt", "decode_fail_v0_1"]
    }
  },
  "oneOf": [
    {
      "title": "encrypt — pin the migrated envelope",
      "additionalProperties": false,
      "required": [
        "vector_id",
        "description",
        "case_kind",
        "input_root_key_hex",
        "input_account_number_hash_hex",
        "input_memory_entry_id_hex",
        "input_plaintext_hex",
        "expected_magic_ascii",
        "expected_blob_hex",
        "expected_version_byte_hex"
      ],
      "properties": {
        "vector_id": { "type": "string" },
        "description": { "type": "string", "minLength": 1 },
        "case_kind": { "const": "encrypt" },
        "input_root_key_hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "input_account_number_hash_hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "input_memory_entry_id_hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "input_plaintext_hex": {
          "type": "string",
          "pattern": "^([0-9a-f]{2})+$"
        },
        "expected_magic_ascii": {
          "const": "MYX5"
        },
        "expected_blob_hex": {
          "type": "string",
          "pattern": "^([0-9a-f]{2})+$"
        },
        "expected_version_byte_hex": {
          "const": "02"
        }
      }
    },
    {
      "title": "decode_fail_v0_1 — the v0.1 expectation refuses the next-major blob",
      "additionalProperties": false,
      "required": [
        "vector_id",
        "description",
        "case_kind",
        "input_blob_hex",
        "input_root_key_hex",
        "input_account_number_hash_hex",
        "input_memory_entry_id_hex",
        "expected_error"
      ],
      "properties": {
        "vector_id": { "type": "string" },
        "description": { "type": "string", "minLength": 1 },
        "case_kind": { "const": "decode_fail_v0_1" },
        "input_blob_hex": {
          "type": "string",
          "pattern": "^([0-9a-f]{2})+$"
        },
        "input_root_key_hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "input_account_number_hash_hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "input_memory_entry_id_hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "expected_error": {
          "const": "magic_mismatch"
        }
      }
    }
  ]
}
