        "agent-memory-merge",
        "chats-catalog",
        "chats-blob",
        "chats-merge"
      ]
    },
    "protocol_version": {
      "type": "string",
      "const": "v0.1",
      "description": "Pins the protocol version this vector set targets."
    },
    "spec_section": {
      "type": "string",
      "minLength": 1,
      "description": "Anchor in the main repo's docs/spec/ that pins the byte-level contract being verified (e.g. 'protocol.md §7.4')."
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "cases": {
      "type": "array",
      "minItems": 1
    }
  },
